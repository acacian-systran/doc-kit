---
title: 「제목」 — 「한 대상의 상태 전이」
config:
  theme: base
---
stateDiagram-v2
%% 답하는 질문: 「한 대상이 어떤 상태를 거치고, 무엇이 전이를 일으키나」
%% 상태: 목표 구조(To-Be).
%% ·
%% 상태도는 "한 대상"에 붙는다. 대상이 둘이면 그림이 둘이다. 전이 라벨은
%% "무엇이 일으키나"(사건)이고 "무엇을 하나"(동작)가 아니다 — 동작은 flowchart 다.
%% ·
%% 읽는 법: 전이 라벨 = 사건. [*] = 밖에서 들어오고 나가는 곳. 색은 palette 와 같다.
%% 렌더: assets/render.sh 「이름」.mmd

  direction LR
  state "접수" as intake
  state "검토" as review
  state "반려" as reject
  state "승인" as approve

  [*] --> intake
  intake --> review : 제출
  review --> reject : 「조건 미달」
  review --> approve : 「통과」
  reject --> intake : 재제출
  approve --> [*]

  state review {
    state "자동판정" as auto
    state "사람검토" as human
    [*] --> auto
    auto --> human : 신뢰도 < 「임계」
    auto --> [*] : 신뢰도 ≥ 「임계」
    human --> [*]
  }

  class review filter
  class auto nondet
  class reject tbd

%% palette:begin
  %% ext    외부 — 우리가 만들지 않은 것. 외부 API · 남의 모듈
  classDef ext fill:#F4F5F6,stroke:#8A94A0,stroke-dasharray:4 3,color:#5A6672
  %% trigger 트리거 — 무엇이 실행을 부르나. cron · 사람 · HTTP 요청. 육각형 {{ }} 과 짝
  classDef trigger fill:#FEF8E6,stroke:#B8941F,color:#6B5511
  %% step   단계 — 무언가를 하는 곳
  classDef step fill:#EFF5FC,stroke:#2E5C8A,color:#1F3A5A
  %% filter 필터 — 거르는 단계와 조건 게이트. 여기서 대상이 줄어든다
  classDef filter fill:#E8F6F5,stroke:#1E7F79,color:#145653
  %% file   파일 — 파일시스템. @{shape: doc} 와 짝
  classDef file fill:#FEF8E6,stroke:#B8941F,color:#6B5511
  %% table  테이블 — RDB, 행을 보관하는 곳. [( )] 과 짝
  classDef table fill:#F4F5F6,stroke:#5A6672,color:#2E3A46
  %% canon  정본 — 같은 DB 지만 잃으면 복구가 어렵거나 비싼 것. 굵은 테두리
  classDef canon fill:#F4F5F6,stroke:#5A6672,stroke-width:3px,color:#2E3A46
  %% index  색인 — 같은 DB 안에서 검색을 받는 곳. 모양은 실린더, 색만 보라
  classDef index fill:#F2EFF9,stroke:#5B4B8A,color:#3E3260
  %% nondet 비결정 — LLM 이 닿는 것, 외부 판정에 매달린 것. 결과가 매번 같지 않다
  classDef nondet fill:#FDF0E3,stroke:#B4691A,color:#8A4B12
  %% tbd    미확정 — 그렸지만 설계가 아직 정하지 않은 자리. 붉은색은 이 뜻이 독점한다.
  %%        구현 여부를 뜻하지 않는다 — grammar.md "미확정" 절
  classDef tbd fill:#FEF6F5,stroke:#C0392B,stroke-dasharray:4 3,color:#A03026
  %% ro     조회 — 쓰기가 하나도 없는 것
  classDef ro fill:#EFF7F0,stroke:#2F5A34,color:#1F3F23
  %% note   각주 — 상자가 아니다. 그림 안에 있어야 읽히는 부연
  classDef note fill:transparent,stroke:transparent,color:#5A6672,font-size:12px
  %% warn   경고각주 — 그림이 말하는 것과 실제가 다른 지점
  classDef warn fill:transparent,stroke:transparent,color:#A03026,font-size:12px
  %% 컨테이너(subgraph)는 classDef 가 아니라 style 로 준다. 점선 = 논리 그룹,
  %% 실선 = 배포 경계 — "같이 묶여 있나"와 "같이 죽나"는 같은 말이 아니다.
  %%   style 「영역id」  fill:#FCFCFB,stroke:#8A94A0,stroke-dasharray:4 3
  %%   style 「배포id」  fill:#F7FAFD,stroke:#5A6672,stroke-width:2px
  %%   style 「앱id」    fill:#EFF5FC,stroke:#2E5C8A,stroke-dasharray:4 3
%% palette:end
