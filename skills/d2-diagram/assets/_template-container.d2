# <제목> — <무엇에 대한 그림인가>
#
# 답하는 질문: <이 그림 하나가 답하는 질문 한 문장>
#
# 컨테이너형. 상자가 스무 개를 넘고 배포 경계가 여럿일 때 쓴다.
# 3열 격자(`_template.d2`)는 단계의 사슬을 그리는 형태라 중첩 경계를 못 담는다.
#
# 렌더: d2 --layout=elk <이름>.d2 <이름>.svg
#       elk 를 쓴다. 기본 dagre 는 컨테이너 간격이 헐렁하다.
#
# ── 쓰는 법 ────────────────────────────────────────────────
# 최상위는 3열 격자다. 열 컨테이너(colA/colB/colC)는 테두리도 배경도 없어서
# 그림에 보이지 않고, 자리만 잡는다. 이것을 빼고 자유 배치에 맡기면 열이
# layout 엔진 손에 넘어간다 — 실제로 넘어가 보면 제일 위여야 할 상자가
# 오른쪽 아래로 간다.
#
# 격자 칸 안의 컨테이너는 자기 레이아웃을 따로 쓴다. 그래서 최상위 격자와
# 중첩 컨테이너를 같이 쓸 수 있다 — 격자를 쓸 수 있는 것은 이 한 겹뿐이다.
#
# `left` · `right` · `center` 는 d2 예약어라 노드 이름으로 못 쓴다.

grid-columns: 3
grid-gap: 90

...@_style

title: |md
  # <제목>
  <부제 — 목표 구조(To-Be) · 빨강 점선 = 미착륙(YYYY-MM-DD 코드 대조)>
| {near: top-center; style.stroke-width: 0}

# ── 왼쪽 열 ────────────────────────────────────────────────
colA: "" {
  style: {stroke-width: 0; fill: transparent}

  upstream: "<앞단 (논리 그룹)>" {
    class: 영역
    a1: "<무엇을 한다>" {class: 단계}
    a2: "<무엇을 한다>" {class: 단계}
    a1 -> a2: {class: 축}

    # 부연은 설명하는 컨테이너 **안**에 둔다. elk 는 `near` 에 상수만 받아
    # `near: <노드>` 로 붙일 수 없고, 안에 두면 테두리가 대상을 묶어 준다.
    note: "* <이 그룹에만 걸리는 사실 — 예: 배포 경계 밖에 그렸지만\n  As-Is 는 같은 프로세스다>" {class: 경고각주}
  }
}

# ── 가운데 열 ──────────────────────────────────────────────
colB: "" {
  style: {stroke-width: 0; fill: transparent}

  client: "<클라이언트>" {class: 단계}

  deploy: "<배포 단위>" {
    class: 배포                      # 실선 = 같이 죽는 것

    app: "<애플리케이션>" {
      class: 앱
      api: "<진입점>" {class: 단계}

      inner: "<내부 그룹>" {
        class: 영역                  # 점선 = 논리 그룹
        s1: "<무엇을 한다>" {class: 단계}
        gate: "<한 벌의 판정 (fail-closed)>\n<두 경로가 같은 규칙을 쓴다>" {class: 필터; style.stroke-width: 3}
        s2: "<무엇을 한다>" {class: 단계}
        gap: "<아직 없는 것>\n* As-Is: <지금은 무엇으로 도나>" {class: 미착륙}
        s1 -> gate: {class: 축}
        gate -> s2: {class: 축}
        gate -> gap: {class: 축}
      }
      api -> inner.s1: {class: 축}
    }

    store: "<상태 저장소>" {
      class: 영역
      db: "<정본>" {class: 정본}
    }
    app.api -> store.db: {class: 부수}
  }

  # 왕복은 한 선으로 합친다. 되돌아가는 선을 따로 그리면 배치를 끌어당겨
  # 클라이언트가 그림 아래로 내려간다.
  client <-> deploy.app.api: {class: 축; label: "<오가는 것>"}
}

# ── 오른쪽 열 ──────────────────────────────────────────────
colC: "" {
  style: {stroke-width: 0; fill: transparent}

  sinks: "<저장소 묶음>" {
    class: 영역
    x1: "<저장소>" {class: 색인}
    note: "* <박스가 갈린 것은 논리 구분이지 배포가 아니다 같은 사실>" {class: 각주}
  }

  obs: "<관측>\n<무엇을 어디로 보내나>" {class: 외부}

  # 사람은 컨테이너가 없으므로 투명 그룹으로 한 겹 싸야 각주를 옆에 붙일 수 있다.
  operator: "" {
    style.opacity: 0
    who: "<운영자>" {shape: person; class: 외부}
    note: "* <운영자가 실제로 만지는 표면은 어디인가>" {class: 각주}
  }
}

# ── 열을 넘는 선 ───────────────────────────────────────────
# 열을 넘는 선은 긴 대각선이 된다. 뜻이 다른 색이라 읽히기는 하지만, 수가
# 늘면 그림을 덮는다 — 열 배치를 바꿔 줄일 수 있는지 먼저 본다.
colA.upstream.a2 -> colB.deploy.app.inner.gate: {class: 판정; label: "<적재도 같은 판정을 쓴다>"}
colB.deploy.app.inner.gate -> colC.sinks.x1: {class: 판정}
colB.deploy.app.inner.s2 -> colC.sinks.x1: {class: 부수}
colB.deploy.app -> colC.obs: {class: 제약}
colC.operator.who -> colB.deploy.app.api: {class: 관리; label: "<제어 표면>"}

# ── 범례 ───────────────────────────────────────────────────
# 고정하지 않으면 레이아웃 엔진이 그림 한복판에 놓는다.
legend: "범례" {
  class: 범례
  near: bottom-left
  grid-columns: 1
  grid-gap: 8
  l1: "── 호출 방향" {class: 각주}
  l2: "── 한 벌의 판정 (<어디와 어디가 같은 규칙인가>)" {class: 각주}
  l3: "┈ 제약 관계 · ┈ 운영자 제어" {class: 각주}
  l4: "□ 논리 그룹 (점선) · □ 배포 경계 (실선)" {class: 각주}
}

footer: "⚠ 미착륙 (빨강 점선) = YYYY-MM-DD 코드에 없는 것 — <무엇과 무엇>.\n검정 * 각주 = 있으나 그림과 다르게 도는 것. 이 표시가 없는 박스 · 선은 코드와 일치한다." {class: 경고각주; near: bottom-right}

# ── 판단의 근거는 그리지 않고 여기 적는다 ──────────────────
# 왜 이 경계를 여기 그었는지, 왜 저 게이트를 두지 않았는지를 주석으로 남긴다.
