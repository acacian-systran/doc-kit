# <제목> — <무엇에 대한 그림인가>
#
# 답하는 질문: <시간 위에서 무엇이 언제, 어디에 있나>
#
# 눕힌 격자. 열 = 시간(또는 국면) · 행 = 어디에 있나.
# 3열 기본형(`_template.d2`)으로 시간을 그리려 하면 단계 축과 시간 축이
# 겹쳐 둘 다 못 읽는다. 시간이 주제일 때만 이 형태를 쓴다.
#
# 렌더: d2 <디렉터리>/<이름>.d2 <디렉터리>/<이름>.svg
#
# ── 쓰는 법 ────────────────────────────────────────────────
# 행 순서로 화살표를 다스린다. 오가는 상대를 인접 행에 두면 화살표가 중간
# 행의 상자를 관통하지 않는다. 관통하는 화살표가 남으면 대개 배치 문제가
# 아니라 그림이 인과를 건너뛰었다는 신호다.
#
# 눕힌 격자라고 굵은 축이 반드시 가로로 흐르지는 않는다. 열이 이어지는 흐름이
# 아니라 겹쳐 도는 두 체제라면 열 사이에 화살표를 두지 않는다 — 가로로 이으면
# 왼쪽이 끝난 뒤 오른쪽이 시작되는 것처럼 읽힌다.
#
# 축의 뜻을 이 머리말과 "읽는 법" 양쪽에 적는다.

grid-rows: 4
grid-columns: 3
grid-gap: 60

...@_style

# ── 열 이름 ────────────────────────────────
# 그림의 일부가 아니라 축의 이름이다. 첫 행을 통째로 쓴다.
c1: "<국면 1>" {class: 열이름}
c2: "<국면 2>" {class: 열이름}
c3: "<국면 3>" {class: 열이름}

# ── 행 1 · <바깥> ──────────────────────────
r1c1: "<이 국면에 바깥에서 오는 것>" {class: 외부}
r1c2: "" {class: 빈칸}
r1c3: "" {class: 빈칸}

# ── 행 2 · <우리 프로세스> ─────────────────
r2c1: "<무엇을 한다>" {class: 단계}
r2c2: "<무엇을 한다>" {class: 단계}
r2c3: "<무엇을 한다>" {class: 단계}

# ── 행 3 · <남는 상태> ─────────────────────
r3c1: "<어디에 남나>" {class: 테이블}
r3c2: "" {class: 빈칸}
r3c3: "<어디에 남나>" {class: 테이블}

# ── 축 ─────────────────────────────────────
# 세로로 흐를 수도, 가로로 흐를 수도 있다. 무엇이 이어지는가에 따라 정한다.
r1c1 -> r2c1: {class: 축}
r2c1 -> r3c1: {class: 부수}
r2c2 -> r2c3: {class: 축}
r3c1 -> r2c2: {class: 읽기}
r2c3 -> r3c3: {class: 부수}

# ── 판단의 근거는 그리지 않고 여기 적는다 ──
# 왜 이 국면을 이 열에 뒀는지, 왜 열 사이를 잇지 않았는지를 주석으로 남긴다.
