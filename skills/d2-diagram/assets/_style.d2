# 공용 어휘 — 색과 모양의 정의 한 벌
#
# 이 파일은 혼자 렌더하지 않는다. 각 그림이 `...@_style` 로 임포트한다.
# 색을 새로 쓰고 싶으면 여기에 클래스를 더한다 — 그림 파일에 색상값을 직접
# 적으면 같은 뜻이 파일마다 다른 색으로 갈라진다.
#
# 규칙 두 줄:
#   모양이 저장소의 종류를 말한다 — 문서는 파일시스템, 실린더는 DB.
#   색이 역할을 말한다 — 파랑은 단계, 청록은 거르는 단계, 보라는 인덱스.
#
# 프로젝트에 없는 개념의 클래스는 지우지 말고 두는 편이 낫다. 쓰지 않으면
# 렌더에 나오지 않고, 나중에 그 개념이 생겼을 때 색을 다시 고르지 않아도 된다.

classes: {
  # ── 바깥 ────────────────────────────────
  # 우리가 만들지 않은 것. 점선 테두리는 "경계 밖"이라는 뜻이다.
  외부: {style: {stroke-dash: 3; stroke: "#8A94A0"; font-color: "#5A6672"}}

  # ── 단계 ────────────────────────────────
  # 무언가를 하는 곳. 파이프라인의 기본색이다.
  단계: {style: {fill: "#EAF2FB"; stroke: "#2E5C8A"}}

  # 거르는 단계와 조건 게이트. 뒤로 넘어가는 대상이 여기서 줄어든다 —
  # 깔때기가 어디서 좁아지는지 라벨을 읽기 전에 보이라고 색을 나눈다.
  필터: {style: {fill: "#E9F4F3"; stroke: "#2F6E63"}}

  # ── 실행 트리거 ─────────────────────────
  # 무엇이 그 실행을 부르나. 육각형은 "밖에서 때리는 것"이고, 단계(파랑 상자)와
  # 달리 우리 코드 안이 아니다 — cron·사람·HTTP 요청·큐 메시지가 여기 온다.
  # 색은 파일과 같고 모양으로 갈린다.
  트리거: {shape: hexagon; style: {fill: "#FDF6E3"; stroke: "#8A7620"}}

  # ── 저장소 ──────────────────────────────
  파일: {shape: page; style: {fill: "#FDF6E3"; stroke: "#8A7620"}}

  테이블: {shape: cylinder; style: {fill: "#F4F7FB"; stroke: "#5A6672"}}

  # 굵은 테두리 = 정본. 이것을 잃으면 다시 만들 수 없거나 값이 비싸다.
  # 캐시나 사본과 구별하려고 두께를 쓴다 — 색은 이미 저장소 종류에 쓰였다.
  # 정본이 파일시스템에 있으면 `shape: page` 로 바꾼다. 모양은 저장소의 종류를
  # 말하는 자리이므로 정본이 옮겨 가면 모양이 따라간다.
  정본: {shape: cylinder; style: {fill: "#F4F7FB"; stroke: "#5A6672"; stroke-width: 3}}

  # 같은 DB 안이지만 성격이 다르다 — 행을 보관하는 곳(회색)과 그 위에 얹혀
  # 검색을 받는 곳(보라). 모양은 같게 두고 색만 가른다.
  색인: {shape: cylinder; style: {fill: "#F2EFF9"; stroke: "#5B4B8A"}}

  # ── 비결정론 ────────────────────────────
  # LLM 이 닿는 것, 외부 판정에 결과가 매달린 것. 이 색이 보이면 결과가
  # 매번 같지 않다.
  비결정: {style: {fill: "#FBF0EF"; stroke: "#8A2F2A"; font-color: "#8A2F2A"}}

  # ── 조회 ────────────────────────────────
  # 쓰기가 하나도 없는 것. 읽기만 하는 경로와 그 주인.
  조회: {style: {fill: "#EFF7F0"; stroke: "#2F5A34"}}

  # ── 선 ──────────────────────────────────
  # 화살표에도 클래스를 준다 — 색상값이 그림 파일로 새면 같은 뜻이 갈라진다.
  축: {style: {stroke: "#2E3A46"; stroke-width: 2}}      # 따라가면 전체가 읽히는 선
  부수: {style: {stroke: "#8A94A0"}}                      # 받아오는 것 · 남기는 것
  읽기: {style: {stroke: "#2F5A34"; stroke-dash: 3}}      # 읽기만 하는 흐름
  호출: {style: {stroke: "#8A2F2A"}}                      # 비결정으로 나가는 흐름

  # ── 소유 영역 ───────────────────────────
  영역: {style: {fill: "#FCFCFB"; stroke: "#8A94A0"; stroke-dash: 2}}

  # ── 격자의 좌표축 이름 ──────────────────
  # 그림의 일부가 아니라 행·열이 무엇인지 말하는 라벨이다. 테두리도 배경도 없어서
  # 상자와 섞이지 않는다 — 열이 시간이거나 행이 계층인 격자에서만 쓴다.
  열이름: {style: {stroke-width: 0; fill: transparent; font-size: 15; bold: true; font-color: "#2E3A46"}}
  행이름: {style: {stroke-width: 0; fill: transparent; font-size: 13; font-color: "#5A6672"}}

  # ── 자리 채우기 ─────────────────────────
  # 격자에서 비는 칸. 자리는 차지하되 보이지 않는다.
  빈칸: {style: {opacity: 0}}
}
