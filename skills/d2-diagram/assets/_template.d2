# <제목> — <무엇에 대한 그림인가>
#
# 답하는 질문: <이 그림 하나가 답하는 질문 한 문장. 두 개면 그림을 둘로 나눈다>
#
# 왼쪽 = 바깥에서 받아오는 것 · 가운데 = 단계 · 오른쪽 = 그 단계가 남기는 것.
# 문서(page)는 파일시스템, 실린더는 DB다.
#
# 렌더: d2 <디렉터리>/<이름>.d2 <디렉터리>/<이름>.svg
#
# ── 쓰는 법 ────────────────────────────────────────────────
# 이 파일을 복사해 이름을 바꾸고 채운다. 그대로 렌더하면 예시 그림이 나온다.
#
# `_style.d2` 가 같은 디렉터리에 있으면 아래 임포트는 그대로 둔다. 한 층 위에
# 뒀으면 `...@../_style` 로 고친다. 색상값을 그림 파일에 직접 적지는 않는다.
#
# 규칙은 이 스킬의 references/grammar.md 에 있다.

# 단계 수만큼 grid-rows 를 늘린다. 열은 셋으로 고정 — 열이 곧 의미다.
grid-rows: 3
grid-columns: 3
grid-gap: 70

...@_style

# ── 1 · <단계 이름> ────────────────────────
# 왼쪽 칸이 비면 빈칸 클래스로 자리만 채운다. 자리를 비우면 격자가 밀린다.
api: "<바깥에서 받는 것>" {class: 외부}
s1: "1 · <무엇을 한다>" {class: 단계}
o1: "<무엇을 남긴다>" {class: 테이블}

# ── 2 · <거르는 단계> ──────────────────────
# 거르는 단계는 필터 색이다. 조건 게이트도 자기 칸을 갖고 같은 색을 쓴다 —
# 괄호로 라벨에 묶으면 조건인지 부연인지 구분되지 않는다.
sp2: "" {class: 빈칸}
s2: "2 · <무엇으로 거른다>\n<통과 조건 한 줄>" {class: 필터}
o2: "<거른 결과를 적어 두는 곳>" {class: 테이블}

# ── 3 · <단계 이름> ────────────────────────
sp3: "" {class: 빈칸}
s3: "3 · <무엇을 한다>" {class: 단계}
o3: "<경로>/**" {class: 파일}

# ── 축 ─────────────────────────────────────
# 굵은 검정만 따라가면 전체가 읽히도록 둔다.
s1 -> s2: {class: 축}
s2 -> s3: {class: 축}

# ── 받아오는 것 · 남기는 것 ────────────────
# 부수 흐름은 얇은 회색이라 축과 섞이지 않는다.
api -> s1: {class: 부수}
s1 -> o1: {class: 부수}
s2 -> o2: {class: 부수}
s3 -> o3: {class: 부수}

# ── 판단의 근거는 그리지 않고 여기 적는다 ──
# 왜 이 순서인지, 왜 이 게이트를 두지 않았는지는 그림에 넣지 않는다.
# 근거 문서의 파일명과 절 번호를 주석으로 남긴다 — 예: <spec 파일명> §2-3.
